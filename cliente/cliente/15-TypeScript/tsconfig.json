{
  "compilerOptions": {
    "target": "ES2020",         // Versión moderna de JS compatible con navegadores
    "module": "ESNext",         // Usa módulos estándar de JS (import/export)
    "moduleResolution": "node", // Ayuda a encontrar archivos
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM"]    // Importante para que TS reconozca comandos de navegador
  }
}